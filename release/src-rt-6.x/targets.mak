## targets

## USB support ##
e:
	@$(MAKE) bin USB="USB" B=E NTFS=y EBTABLES=y IPV6SUPP=y USBEXTRAS=y BCMNAT=y OPENVPN=y FTPSSL=y PPTPD=y \
	    BBEXTRAS=y STUBBY=y ADVTHEMES=y OPENSSL30=y PROXY=y BUILD_DESC="$(VPN)"

o:
	@$(MAKE) bin USB="USB" B=E NTFS=y EBTABLES=y IPV6SUPP=y USBEXTRAS=y BCMNAT=y OPENVPN=y FTPSSL=y KEYGEN=y PPTPD=y \
	    BBEXTRAS=y MEDIASRV=y DNSCRYPT=y STUBBY=y NOCAT=y TOR=y BTCLIENT=y NFS=y SNMP=y UPS=y TR_EXTRAS=y IPSEC=y DNSSEC=y TINC=y NANO=y HFS=y IPERF=y TERMLIB=y ADVTHEMES=y OPENSSL30=y PROXY=y BONDING=y FULL_EXTRAS=y BUILD_DESC="Mega-VPN"

z:
	@$(MAKE) bin USB="USB" B=E NTFS=y EBTABLES=y IPV6SUPP=y USBEXTRAS=y BCMNAT=y OPENVPN=y FTPSSL=y KEYGEN=y PPTPD=y \
	    BBEXTRAS=y MEDIASRV=y DNSCRYPT=y STUBBY=y NOCAT=y TOR=y BTCLIENT=y NFS=y SNMP=y UPS=y TR_EXTRAS=y IPSEC=y DNSSEC=y TINC=y NANO=y HFS=y NGINX=y IPERF=y TERMLIB=y ADVTHEMES=y OPENSSL30=y PROXY=y BONDING=y MDNS=y QRCODE=y AIO=y FULL_EXTRAS=y BUILD_DESC="AIO"


## RT-AC targets ##
r64z:
	@$(MAKE) z MWAN_MAX=$(if $(MWAN_MAX),$(MWAN_MAX),4) MIPS32=r2 NVRAM_64K=y MICROSD=y ASUS_TRX="RT-N66U" UFSD=y ROAM=y HAVEGED=y

r64e:
	@$(MAKE) e MWAN_MAX=$(if $(MWAN_MAX),$(MWAN_MAX),4) MIPS32=r2 NVRAM_64K=y MICROSD=y MEDIASRV=y ASUS_TRX="RT-N66U" UFSD=y ROAM=y HAVEGED=y

ac66e:
	@$(MAKE) e MWAN_MAX=$(if $(MWAN_MAX),$(MWAN_MAX),4) MIPS32=r2 NVRAM_64K=y NAND=y MEDIASRV=y ASUS_TRX="RT-AC66U" AC66U=y UFSD=y ROAM=y HAVEGED=y

ac66z:
