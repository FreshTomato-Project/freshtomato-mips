	@$(MAKE) e MWAN_MAX=$(if $(MWAN_MAX),$(MWAN_MAX),4) MIPS32=r2 NVRAM_64K=y MEDIASRV=y ASUS_TRX="W1800R" ROAM=y HAVEGED=y

w1800rz:
	@$(MAKE) o MWAN_MAX=$(if $(MWAN_MAX),$(MWAN_MAX),4) MIPS32=r2 NVRAM_64K=y ASUS_TRX="W1800R" ROAM=y HAVEGED=y

ea6500v1e:
	@$(MAKE) e MWAN_MAX=$(if $(MWAN_MAX),$(MWAN_MAX),4) MIPS32=r2 NVRAM_64K=y NAND=y MEDIASRV=y EA6500V1=y NO_JFFS=y ROAM=y HAVEGED=y

ea6500v1o:
	@$(MAKE) o MWAN_MAX=$(if $(MWAN_MAX),$(MWAN_MAX),4) MIPS32=r2 NVRAM_64K=y NAND=y EA6500V1=y NO_JFFS=y ROAM=y HAVEGED=y

r6300e:
	@$(MAKE) e MWAN_MAX=$(if $(MWAN_MAX),$(MWAN_MAX),4) MIPS32=r2 NVRAM_64K=y NAND=y MEDIASRV=y ASUS_TRX="R6300V1" R6300V1=y ROAM=y HAVEGED=y

r6300z:
	@$(MAKE) z MWAN_MAX=$(if $(MWAN_MAX),$(MWAN_MAX),4) MIPS32=r2 NVRAM_64K=y NAND=y ASUS_TRX="R6300V1" R6300V1=y ROAM=y HAVEGED=y

wndr4500e:
	@$(MAKE) e MWAN_MAX=$(if $(MWAN_MAX),$(MWAN_MAX),4) MIPS32=r2 NVRAM_64K=y NAND=y MEDIASRV=y ASUS_TRX="WNDR4500V1" WNDR4500V1=y ROAM=y HAVEGED=y

wndr4500z:
	@$(MAKE) z MWAN_MAX=$(if $(MWAN_MAX),$(MWAN_MAX),4) MIPS32=r2 NVRAM_64K=y NAND=y ASUS_TRX="WNDR4500V1" WNDR4500V1=y ROAM=y HAVEGED=y

wndr4500v2e:
	@$(MAKE) e MWAN_MAX=$(if $(MWAN_MAX),$(MWAN_MAX),4) MIPS32=r2 NVRAM_64K=y NAND=y MEDIASRV=y ASUS_TRX="WNDR4500V2" WNDR4500V2=y ROAM=y HAVEGED=y

wndr4500v2z:
	@$(MAKE) z MWAN_MAX=$(if $(MWAN_MAX),$(MWAN_MAX),4) MIPS32=r2 NVRAM_64K=y NAND=y ASUS_TRX="WNDR4500V2" WNDR4500V2=y ROAM=y HAVEGED=y

n80o:
	@$(MAKE) o MWAN_MAX=$(if $(MWAN_MAX),$(MWAN_MAX),4) MIPS32=r2 NVRAM_64K=y ASUS_TRX="TDN80" ROAM=y HAVEGED=y

## 32K NVRAM ##
dir865le:
	@$(MAKE) bin MWAN_MAX=$(if $(MWAN_MAX),$(MWAN_MAX),2) MIPS32=r2 B=E USB="USB" NVRAM_SIZE=32 USBEXTRAS=y NTFS=y EBTABLES=y IPV6SUPP=y BBEXTRAS=y NANO=y DNSSEC=y DNSCRYPT=y STUBBY=y ADVTHEMES=y OPENSSL30=y ASUS_TRX="DIR865L" \
	    PROXY=y BUILD_DESC="Custom" ROAM=y HAVEGED=y

dir865lo:
	@$(MAKE) o MWAN_MAX=$(if $(MWAN_MAX),$(MWAN_MAX),2) MIPS32=r2 NVRAM_SIZE=32 ASUS_TRX="DIR865L" ROAM=y HAVEGED=y
