From c852b2a6f973e32fe738e93f2b7d849841fa7a8e Mon Sep 17 00:00:00 2001
From: pedro311 <pedro311@gmail.com>
Date: Tue, 8 Sep 2026 11:03:33 +0000
Subject: [PATCH] validate mixed-mode intra prediction first

Backport the upstream ordering fix for mixed-mode intra prediction.

The left-neighbor lookup can return a negative mode.  Validate it before
using the value in the MBAFF constrained-intra mode calculation,
preventing an out-of-array read on malformed H.264 input.

Upstream-Commit: 9734a7a1de3043f012ad0f1ef11027d9488067e6
Security-Fix: out-of-bounds-read
---
 ffmpeg/libavcodec/h264.c | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git ffmpeg/libavcodec/h264.c ffmpeg/libavcodec/h264.c
index b5709eb..e2ee00f 100644
--- ffmpeg/libavcodec/h264.c
+++ ffmpeg/libavcodec/h264.c
@@ -147,18 +147,18 @@ int ff_h264_check_intra_pred_mode(H264Context *h, int mode, int is_chroma)
 
     if ((h->left_samples_available & 0x8080) != 0x8080) {
         mode = left[mode];
-        if (is_chroma && (h->left_samples_available & 0x8080)) {
-            // mad cow disease mode, aka MBAFF + constrained_intra_pred
-            mode = ALZHEIMER_DC_L0T_PRED8x8 +
-                   (!(h->left_samples_available & 0x8000)) +
-                   2 * (mode == DC_128_PRED8x8);
-        }
         if (mode < 0) {
             av_log(h->s.avctx, AV_LOG_ERROR,
                    "left block unavailable for requested intra mode at %d %d\n",
                    s->mb_x, s->mb_y);
             return -1;
         }
+        if (is_chroma && (h->left_samples_available & 0x8080)) {
+            // mad cow disease mode, aka MBAFF + constrained_intra_pred
+            mode = ALZHEIMER_DC_L0T_PRED8x8 +
+                   (!(h->left_samples_available & 0x8000)) +
+                   2 * (mode == DC_128_PRED8x8);
+        }
     }
 
     return mode;
