From 8b2800ccac9e2d6428c1072be9596f26c0841ab6 Mon Sep 17 00:00:00 2001
From: pedro311 <pedro311@gmail.com>
Date: Tue, 8 Sep 2026 11:03:33 +0000
Subject: [PATCH] fully validate deblocking filter offsets

The old check accepted deblocking offsets across the much wider 0..104
internal range. H.264 only permits the parsed alpha and beta offsets within
+/-6, represented here as 52 +/- 12 after scaling. Reject values outside
that range before they can index loop-filter tables.

The same vulnerable validation primitive was later assigned
CVE-2014-125010.

Upstream-Commit: 91253839e14cce9793ee93f184cef609ca8195d5
Related-CVE: CVE-2014-125010
Security-Fix: out-of-bounds-read
---
 ffmpeg/libavcodec/h264.c      | 6 ++++--
 ffmpeg/libavcodec/h264.c.orig | 5 +++--
 2 files changed, 7 insertions(+), 4 deletions(-)

diff --git ffmpeg/libavcodec/h264.c ffmpeg/libavcodec/h264.c
index 11706d4..5a3cb30 100644
--- ffmpeg/libavcodec/h264.c
+++ ffmpeg/libavcodec/h264.c
@@ -3588,8 +3588,10 @@ static int decode_slice_header(H264Context *h, H264Context *h0)
         if (h->deblocking_filter) {
             h->slice_alpha_c0_offset += get_se_golomb(&s->gb) << 1;
             h->slice_beta_offset     += get_se_golomb(&s->gb) << 1;
-            if (h->slice_alpha_c0_offset > 104U ||
-                h->slice_beta_offset     > 104U) {
+            if (h->slice_alpha_c0_offset < 52 - 12 ||
+                h->slice_alpha_c0_offset > 52 + 12 ||
+                h->slice_beta_offset     < 52 - 12 ||
+                h->slice_beta_offset     > 52 + 12) {
                 av_log(s->avctx, AV_LOG_ERROR,
                        "deblocking filter parameters %d %d out of range\n",
                        h->slice_alpha_c0_offset, h->slice_beta_offset);
diff --git ffmpeg/libavcodec/h264.c.orig ffmpeg/libavcodec/h264.c.orig
index ebedb9a..11706d4 100644
--- ffmpeg/libavcodec/h264.c.orig
+++ ffmpeg/libavcodec/h264.c.orig
@@ -4583,9 +4583,10 @@ again:
                 context_count = 0;
             }
 
-            if (err < 0)
+            if (err < 0) {
                 av_log(h->s.avctx, AV_LOG_ERROR, "decode_slice_header error\n");
-            else if (err == 1) {
+                h->ref_count[0] = h->ref_count[1] = h->list_count = 0;
+            } else if (err == 1) {
                 /* Slice could not be decoded in parallel mode, copy down
                  * NAL unit stuff to context 0 and restart. Note that
                  * rbsp_buffer is not transferred, but since we no longer
